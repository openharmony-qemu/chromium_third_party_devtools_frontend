+    const kebabTitle = Platform.StringUtilities.toKebabCase(title);
+    const viewId =
+        Platform.StringUtilities.isExtendedKebabCase(kebabTitle) ? kebabTitle : 'extension-panel' as Lowercase<string>;
     super({title, viewId});
     this.name = name;
     this.panel = panel;
   }
 
